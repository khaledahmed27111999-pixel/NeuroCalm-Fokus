# ==============================================================================
# NeuroCalm & Fokus — Client Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' for local development with Supabase.
# 2. Replace placeholders with your actual Supabase project credentials.
# 3. DO NOT commit '.env.local' or real API keys to version control.
# 4. NEVER use a service_role key, database password, or secret key here.
#    Only the public URL and the public 'anon' key are safe for client browsers.
# 5. When these variables are unset or empty, the app runs in 100% offline,
#    local-first mode without network dependencies or errors.
# ==============================================================================

# Supabase Project URL (HTTPS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Browser-safe publishable API key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key_only
